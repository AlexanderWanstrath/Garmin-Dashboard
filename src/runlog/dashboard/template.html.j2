<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Training Dashboard</title>
<script>
  // Apply the saved theme before first paint to avoid a flash.
  // ?theme=light|dark in the URL wins (handy for screenshots), then the saved choice.
  try {
    const t = new URLSearchParams(location.search).get("theme") || localStorage.getItem("runlog-theme");
    if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
  } catch (e) {}
</script>
<style>
:root {
  color-scheme: light;
  --page: #f9f9f7;
  --surface-1: #fcfcfb;
  --text-primary: #0b0b0b;
  --text-secondary: #52514e;
  --muted: #898781;
  --grid: #e1e0d9;
  --axis: #c3c2b7;
  --border: rgba(11, 11, 11, 0.10);
  --series-1: #2a78d6;
  --series-2: #eb6834;
  --series-3: #1baf7a;
  --series-4: #eda100;
  --plan: #c3c2b7;
  --band: #8987812e;
  --good: #0ca30c;
  --warning: #fab219;
  --critical: #d03b3b;
  --on-status: #ffffff;
  --on-warning: #0b0b0b;
}
@media (prefers-color-scheme: dark) {
  :root:where(:not([data-theme="light"])) {
    color-scheme: dark;
    --page: #0d0d0d;
    --surface-1: #1a1a19;
    --text-primary: #f0efec;
    --text-secondary: #c3c2b7;
    --muted: #898781;
    --grid: #2c2c2a;
    --axis: #383835;
    --border: rgba(255, 255, 255, 0.10);
    --series-1: #3987e5;
    --series-2: #d95926;
    --series-3: #199e70;
    --series-4: #c98500;
    --plan: #52514e;
    --band: #c3c2b724;
  }
}
:root[data-theme="dark"] {
  color-scheme: dark;
  --page: #0d0d0d;
  --surface-1: #1a1a19;
  --text-primary: #f0efec;
  --text-secondary: #c3c2b7;
  --muted: #898781;
  --grid: #2c2c2a;
  --axis: #383835;
  --border: rgba(255, 255, 255, 0.10);
  --series-1: #3987e5;
  --series-2: #d95926;
  --series-3: #199e70;
  --series-4: #c98500;
  --plan: #52514e;
  --band: #c3c2b724;
}
* { box-sizing: border-box; }
body {
  margin: 0;
  background: var(--page);
  color: var(--text-primary);
  font: 14px/1.45 system-ui, -apple-system, "Segoe UI", sans-serif;
}
main { max-width: 1240px; margin: 0 auto; padding: 24px 16px 48px; }
header { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
h1 { font-size: 20px; font-weight: 600; margin: 0; }
h2 { font-size: 15px; font-weight: 600; margin: 0 0 2px; }
h3 { font-size: 13px; font-weight: 600; margin: 16px 0 4px; color: var(--text-secondary); }
.sub { color: var(--text-secondary); font-size: 13px; margin: 0 0 8px; }
.note { color: var(--muted); font-size: 12px; margin: -4px 0 8px; }
.muted { color: var(--muted); }
button.theme {
  font: inherit; color: var(--text-secondary); background: var(--surface-1);
  border: 1px solid var(--border); border-radius: 6px; padding: 4px 10px; cursor: pointer;
}
nav.tabs { display: flex; gap: 4px; margin: 16px 0; border-bottom: 1px solid var(--axis); overflow-x: auto; }
nav.tabs a { padding: 8px 14px; color: var(--text-secondary); text-decoration: none; border-bottom: 2px solid transparent;
  margin-bottom: -1px; white-space: nowrap; font-weight: 500; }
nav.tabs a[aria-current="page"] { color: var(--text-primary); border-bottom-color: var(--series-1); }
.page[hidden] { display: none; }
.card { background: var(--surface-1); border: 1px solid var(--border); border-radius: 10px; padding: 16px; min-width: 0; }
.strip { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 16px; }
.strip .card { padding: 10px 14px; flex: 1 1 160px; }
.tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 12px; margin-bottom: 16px; }
.tile .label { color: var(--text-secondary); font-size: 12px; }
.tile .value { font-size: 18px; font-weight: 600; margin: 2px 0; display: flex; align-items: center; gap: 8px; }
.tile .detail { color: var(--muted); font-size: 12px; }
.status { display: inline-flex; align-items: center; justify-content: center; width: 20px; height: 20px;
  border-radius: 50%; font-size: 12px; font-weight: 700; color: var(--on-status); flex: none; }
.status.big { width: 28px; height: 28px; font-size: 15px; }
.status.green { background: var(--good); }
.status.yellow { background: var(--warning); color: var(--on-warning); }
.status.red { background: var(--critical); }
.row2 { display: grid; grid-template-columns: minmax(280px, 1fr) 2fr; gap: 16px; margin-bottom: 16px; }
.level { display: flex; align-items: center; gap: 10px; font-size: 20px; font-weight: 600; margin: 6px 0 2px; }
.signals { list-style: none; padding: 0; margin: 8px 0 0; }
.signals li { display: flex; align-items: center; gap: 8px; padding: 5px 0; border-top: 1px solid var(--grid); }
.signals li:first-child { border-top: 0; }
.signals .name { width: 110px; flex: none; color: var(--text-secondary); }
.signals .value { font-weight: 600; min-width: 28px; }
.advice { margin: 4px 0 0; padding-left: 18px; }
.advice li { margin: 4px 0; }
table { border-collapse: collapse; width: 100%; font-size: 13px; }
th { text-align: left; font-weight: 600; color: var(--text-secondary); border-bottom: 1px solid var(--axis); padding: 6px 8px; }
td { border-bottom: 1px solid var(--grid); padding: 6px 8px; vertical-align: top; font-variant-numeric: tabular-nums; }
tr.today td { background: var(--band); }
tr.week th { padding-top: 14px; color: var(--text-primary); border-bottom: 1px solid var(--axis); }
tr.week th .muted { font-weight: 400; }
.small { color: var(--muted); font-size: 12px; }
.finding { color: var(--text-secondary); font-size: 12px; }
.finding::before { content: "! "; font-weight: 700; color: var(--critical); }
.scroll { overflow-x: auto; }
.charts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; margin-bottom: 16px; }
.charts .wide { grid-column: 1 / -1; }
.plot { width: 100%; }
.empty { height: 120px; display: flex; align-items: center; justify-content: center; color: var(--muted); }
details { margin-top: 8px; }
summary { cursor: pointer; color: var(--text-secondary); font-size: 12px; }
details table { margin-top: 8px; }
footer { margin-top: 24px; color: var(--muted); font-size: 12px; }
@media (max-width: 900px) {
  .row2, .charts { grid-template-columns: minmax(0, 1fr); }
}
</style>
</head>
<body>
{% set ICON = {"green": "✓", "yellow": "!", "red": "✕"} %}
{% macro tile(t) %}
    <div class="card tile">
      <div class="label">{{ t.label }}</div>
      <div class="value">
        {% if t.status %}<span class="status {{ t.status }}" aria-hidden="true">{{ ICON[t.status] }}</span>{% endif %}
        {{ t.value }}
      </div>
      <div class="detail">{{ t.detail }}</div>
    </div>
{% endmacro %}
{% macro chart_grid(list) %}
<section class="charts">
{% for c in list %}
  <div class="card{% if c.wide %} wide{% endif %}">
    <h2>{{ c.title }}</h2>
    <p class="sub">{{ c.subtitle }}</p>
    {% if c.note %}<p class="note">{{ c.note }}</p>{% endif %}
    {% if c.empty %}<div class="empty">{{ c.empty }}</div>{% else %}<div class="plot" id="chart-{{ c.id }}" style="height:{{ c.height }}px" role="img" aria-label="{{ c.title }}: {{ c.subtitle }}"></div>{% endif %}
    <details>
      <summary>Table</summary>
      <div class="scroll"><table>
        <thead><tr>{% for col in c.table.columns %}<th>{{ col }}</th>{% endfor %}</tr></thead>
        <tbody>{% for row in c.table.rows %}<tr>{% for v in row %}<td>{{ "–" if v is none else v }}</td>{% endfor %}</tr>{% endfor %}</tbody>
      </table></div>
    </details>
  </div>
{% endfor %}
</section>
{% endmacro %}
{% macro session_row(r, show_type=True) %}
        <tr{% if r.today %} class="today"{% endif %}>
          <td>{{ r.weekday }} {{ r.date }}</td>
          <td>{{ r.session }}<div class="small">{{ r.type }}</div>{% for f in r.findings %}<div class="finding">{{ f }}</div>{% endfor %}</td>
          <td>{{ r.target or "–" }}</td>
          <td>{{ r.planned }}</td>
          <td>{{ r.actual_km }}{% if r.actual %}<div class="small">{{ r.actual }}</div>{% endif %}</td>
          <td>{{ r.status }}</td>
        </tr>
{% endmacro %}
<main>
<header>
  <h1>Training Dashboard</h1>
  <div>
    <span class="muted">Data until {{ d.today.strftime("%a %d.%m.%Y") }}</span>
    <button class="theme" id="theme" type="button" aria-label="Switch color theme">Theme: auto</button>
  </div>
</header>

<nav class="tabs" aria-label="Pages">
  <a href="#overview" data-page="overview">Overview</a>
  <a href="#plan" data-page="plan">Marathon plan</a>
  <a href="#health" data-page="health">Health</a>
</nav>

<!-- Overview ---------------------------------------------------------------->
<div class="page" id="page-overview">
<section class="strip">
  {{ tile(d.week) }}
  {% for t in d.countdown %}{{ tile(t) }}{% endfor %}
</section>

<section class="row2">
  <div class="card">
    <h2>Morning check</h2>
    <div class="level">
      {% if d.morning.level %}<span class="status big {{ d.morning.level }}" aria-hidden="true">{{ ICON[d.morning.level] }}</span>{{ d.morning.level|capitalize }}{% else %}<span class="muted">No data</span>{% endif %}
    </div>
    <ul class="signals">
    {% for s in d.morning.signals %}
      <li>
        <span class="name">{{ {"tendon": "Patellar tendon", "hrv": "HRV", "resting_hr": "Resting HR", "legs": "Legs"}.get(s.signal, s.signal) }}</span>
        {% if s.level %}<span class="status {{ s.level }}" aria-hidden="true">{{ ICON[s.level] }}</span>{% else %}<span class="muted">–</span>{% endif %}
        <span class="muted">{{ s.reason }}</span>
      </li>
    {% endfor %}
    {% for t in d.wellness %}
      <li>
        <span class="name">{{ t.label }}</span>
        <span class="value">{{ t.value }}</span>
        <span class="muted">{{ t.detail }}</span>
      </li>
    {% endfor %}
    </ul>
    <h3>Warnings and recommendations</h3>
    {% if d.advice %}
    <ul class="advice">{% for w in d.advice %}<li>{{ w }}</li>{% endfor %}</ul>
    {% else %}<p class="muted">None.</p>{% endif %}
  </div>
  <div class="card">
    <h2>Plan</h2>
    <p class="sub">Last {{ 14 }} days and the coming week: target against how you ran it</p>
    {% if d.plan_rows %}
    <div class="scroll"><table>
      <thead><tr><th>Date</th><th>Session</th><th>Target</th><th>Planned</th><th>Done</th><th>Status</th></tr></thead>
      <tbody>
      {% for r in d.plan_rows %}{{ session_row(r) }}{% endfor %}
      </tbody>
    </table></div>
    {% else %}<p class="muted">No plan.yaml, or no sessions around today.</p>{% endif %}
  </div>
</section>

<section class="card" style="margin-bottom:16px">
  <h2>Runs, last 14 days</h2>
  <div class="scroll"><table>
    <thead><tr><th>Date</th><th>Name</th><th>km</th><th>Pace</th><th>Avg HR</th><th>Above easy cap</th><th>Aerobic TE</th><th>RPE</th><th>VO2max</th></tr></thead>
    <tbody>
    {% for r in d.runs %}
      <tr>
        <td>{{ r.date }}</td><td>{{ r.name or r.type }}</td><td>{{ r.distance_km }}</td><td>{{ r.pace_min_per_km or "–" }}</td>
        <td>{{ r.avg_hr_bpm or "–" }}</td>
        <td>{% for k, v in r.items() if k.startswith("time_above_") %}{{ "–" if v is none else v ~ " %" }}{% endfor %}</td>
        <td>{{ r.aerobic_training_effect or "–" }}</td><td>{{ r.garmin_rpe_1_to_10 or "–" }}</td><td>{{ r.vo2max or "–" }}</td>
      </tr>
    {% else %}
      <tr><td colspan="9" class="muted">No runs in the last 14 days.</td></tr>
    {% endfor %}
    </tbody>
  </table></div>
</section>

{{ chart_grid(pages.overview) }}
</div>

<!-- Marathon plan ----------------------------------------------------------->
<div class="page" id="page-plan" hidden>
{% if d.progress %}
{{ chart_grid(pages.plan) }}
<section class="card">
  <h2>All sessions</h2>
  <p class="sub">{{ "%g"|format(d.progress.planned_km_total) }} km planned in total; target against how you ran it</p>
  <div class="scroll"><table>
    <thead><tr><th>Date</th><th>Session</th><th>Target</th><th>Planned</th><th>Done</th><th>Status</th></tr></thead>
    <tbody>
    {% for w in d.plan_weeks %}
      <tr class="week"><th colspan="6">{{ w.title }} <span class="muted">· {{ w.planned }} planned{% if not w.future %} · {{ "%g"|format(w.done_km) }} km run{% endif %}</span></th></tr>
      {% for r in w.sessions %}{{ session_row(r) }}{% endfor %}
    {% endfor %}
    </tbody>
  </table></div>
</section>
{% else %}
<p class="muted">No plan.yaml: copy plan.example.yaml to plan.yaml and enter your plan.</p>
{% endif %}
</div>

<!-- Health ------------------------------------------------------------------>
<div class="page" id="page-health" hidden>
<section class="tiles">
  {% for t in d.health_tiles %}{{ tile(t) }}{% endfor %}
</section>
{{ chart_grid(pages.health) }}
</div>

<footer>Generated by runlog from Garmin data. Charts need an internet connection to load Plotly.</footer>
</main>

<script src="{{ plotly_js }}"></script>
<script>
const CHARTS = {{ charts | tojson }};
const root = document.documentElement;

function token(name) { return getComputedStyle(root).getPropertyValue(name).trim(); }

// Replace "var(--x)" strings with the current theme's value, recursively.
function resolve(value) {
  if (typeof value === "string") {
    const m = value.match(/^var\((--[\w-]+)\)$/);
    return m ? token(m[1]) : value;
  }
  if (Array.isArray(value)) return value.map(resolve);
  if (value && typeof value === "object") {
    const out = {};
    for (const [k, v] of Object.entries(value)) out[k] = resolve(v);
    return out;
  }
  return value;
}

function merge(base, extra) {
  const out = { ...base };
  for (const [k, v] of Object.entries(extra || {})) {
    out[k] = v && typeof v === "object" && !Array.isArray(v) && base[k] ? merge(base[k], v) : v;
  }
  return out;
}

function baseLayout() {
  const axis = {
    gridcolor: "var(--grid)", linecolor: "var(--axis)", zeroline: false, showline: false,
    tickfont: { color: "var(--muted)", size: 11 }, automargin: true, fixedrange: true,
  };
  return {
    font: { family: 'system-ui, -apple-system, "Segoe UI", sans-serif', color: "var(--text-secondary)", size: 12 },
    paper_bgcolor: "rgba(0,0,0,0)", plot_bgcolor: "rgba(0,0,0,0)",
    margin: { l: 8, r: 8, t: 8, b: 8 },
    xaxis: { ...axis, showgrid: false, showline: true },
    yaxis: { ...axis, showgrid: true, rangemode: "tozero" },
    legend: { orientation: "h", x: 0, y: 1.02, yanchor: "bottom", font: { color: "var(--text-secondary)" } },
    hovermode: "closest",
    hoverlabel: { bgcolor: "var(--surface-1)", bordercolor: "var(--axis)", font: { color: "var(--text-primary)" } },
    bargap: 0.45, bargroupgap: 0.08, barcornerradius: 4,
  };
}

const PAGES = ["overview", "plan", "health"];
function currentPage() {
  const p = location.hash.slice(1);
  return PAGES.includes(p) ? p : "overview";
}

// Plotly measures its container, so only the visible page is drawn; switching pages redraws.
function render() {
  if (!window.Plotly) return;
  const page = currentPage();
  for (const c of CHARTS) {
    const el = document.getElementById("chart-" + c.id);
    if (!el || c.page !== page) continue;
    Plotly.react(el, resolve(c.data), resolve(merge(baseLayout(), c.layout)),
      { displayModeBar: false, responsive: true });
  }
}

// Theme toggle: auto (follows the OS) -> light -> dark.
const button = document.getElementById("theme");
function label() { button.textContent = "Theme: " + (root.dataset.theme || "auto"); }
button.addEventListener("click", () => {
  const next = { undefined: "light", light: "dark", dark: undefined }[root.dataset.theme];
  if (next) root.dataset.theme = next; else delete root.dataset.theme;
  try { next ? localStorage.setItem("runlog-theme", next) : localStorage.removeItem("runlog-theme"); } catch (e) {}
  label(); render();
});
function showPage() {
  const page = currentPage();
  for (const p of PAGES) document.getElementById("page-" + p).hidden = p !== page;
  for (const a of document.querySelectorAll("nav.tabs a")) {
    if (a.dataset.page === page) a.setAttribute("aria-current", "page"); else a.removeAttribute("aria-current");
  }
  render();
}
window.addEventListener("hashchange", showPage);
matchMedia("(prefers-color-scheme: dark)").addEventListener("change", render);
label();
showPage();
</script>
</body>
</html>
