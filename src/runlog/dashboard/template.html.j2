<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Training Dashboard</title>
<script>
  // Apply the saved theme before first paint to avoid a flash.
  // ?theme=light|dark in the URL wins (handy for screenshots), then the saved choice.
  try {
    const t = new URLSearchParams(location.search).get("theme") || localStorage.getItem("runlog-theme");
    if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
  } catch (e) {}
</script>
<style>
:root {
  color-scheme: light;
  --page: #f9f9f7;
  --surface-1: #fcfcfb;
  --text-primary: #0b0b0b;
  --text-secondary: #52514e;
  --muted: #898781;
  --grid: #e1e0d9;
  --axis: #c3c2b7;
  --border: rgba(11, 11, 11, 0.10);
  --series-1: #2a78d6;
  --series-2: #eb6834;
  --series-3: #1baf7a;
  --series-4: #eda100;
  --plan: #c3c2b7;
  --band: #8987812e;
  --good: #0ca30c;
  --warning: #fab219;
  --critical: #d03b3b;
  --on-status: #ffffff;
  --on-warning: #0b0b0b;
}
@media (prefers-color-scheme: dark) {
  :root:where(:not([data-theme="light"])) {
    color-scheme: dark;
    --page: #0d0d0d;
    --surface-1: #1a1a19;
    --text-primary: #f0efec;
    --text-secondary: #c3c2b7;
    --muted: #898781;
    --grid: #2c2c2a;
    --axis: #383835;
    --border: rgba(255, 255, 255, 0.10);
    --series-1: #3987e5;
    --series-2: #d95926;
    --series-3: #199e70;
    --series-4: #c98500;
    --plan: #52514e;
    --band: #c3c2b724;
  }
}
:root[data-theme="dark"] {
  color-scheme: dark;
  --page: #0d0d0d;
  --surface-1: #1a1a19;
  --text-primary: #f0efec;
  --text-secondary: #c3c2b7;
  --muted: #898781;
  --grid: #2c2c2a;
  --axis: #383835;
  --border: rgba(255, 255, 255, 0.10);
  --series-1: #3987e5;
  --series-2: #d95926;
  --series-3: #199e70;
  --series-4: #c98500;
  --plan: #52514e;
  --band: #c3c2b724;
}
* { box-sizing: border-box; }
body {
  margin: 0;
  background: var(--page);
  color: var(--text-primary);
  font: 14px/1.45 system-ui, -apple-system, "Segoe UI", sans-serif;
}
main { max-width: 1240px; margin: 0 auto; padding: 24px 16px 48px; }
header { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
h1 { font-size: 20px; font-weight: 600; margin: 0; }
h2 { font-size: 15px; font-weight: 600; margin: 0 0 2px; }
.sub { color: var(--text-secondary); font-size: 13px; margin: 0 0 8px; }
.muted { color: var(--muted); }
button.theme {
  font: inherit; color: var(--text-secondary); background: var(--surface-1);
  border: 1px solid var(--border); border-radius: 6px; padding: 4px 10px; cursor: pointer;
}
.card { background: var(--surface-1); border: 1px solid var(--border); border-radius: 10px; padding: 16px; min-width: 0; }
.top { display: grid; grid-template-columns: minmax(220px, 1.2fr) 3fr; gap: 16px; margin: 20px 0 16px; }
.hero .value { font-size: 48px; font-weight: 600; line-height: 1.1; margin: 4px 0; }
.tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 12px; }
.tile .label { color: var(--text-secondary); font-size: 13px; }
.tile .value { font-size: 22px; font-weight: 600; margin: 2px 0; display: flex; align-items: center; gap: 8px; }
.tile .detail { color: var(--muted); font-size: 12px; }
.status { display: inline-flex; align-items: center; justify-content: center; width: 20px; height: 20px;
  border-radius: 50%; font-size: 12px; font-weight: 700; color: var(--on-status); flex: none; }
.status.green { background: var(--good); }
.status.yellow { background: var(--warning); color: var(--on-warning); }
.status.red { background: var(--critical); }
.row2 { display: grid; grid-template-columns: 1fr 1.6fr; gap: 16px; margin-bottom: 16px; }
.signals { list-style: none; padding: 0; margin: 8px 0 0; }
.signals li { display: flex; align-items: center; gap: 8px; padding: 5px 0; border-top: 1px solid var(--grid); }
.signals li:first-child { border-top: 0; }
.signals .name { width: 90px; color: var(--text-secondary); }
.warnings { margin: 12px 0 0; padding-left: 18px; }
table { border-collapse: collapse; width: 100%; font-size: 13px; }
th { text-align: left; font-weight: 600; color: var(--text-secondary); border-bottom: 1px solid var(--axis); padding: 6px 8px; }
td { border-bottom: 1px solid var(--grid); padding: 6px 8px; vertical-align: top; font-variant-numeric: tabular-nums; }
tr.today td { background: var(--band); }
.finding { color: var(--text-secondary); font-size: 12px; }
.finding::before { content: "! "; font-weight: 700; color: var(--critical); }
.scroll { overflow-x: auto; }
.charts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
.plot { width: 100%; height: 280px; }
.empty { height: 120px; display: flex; align-items: center; justify-content: center; color: var(--muted); }
details { margin-top: 8px; }
summary { cursor: pointer; color: var(--text-secondary); font-size: 12px; }
details table { margin-top: 8px; }
footer { margin-top: 24px; color: var(--muted); font-size: 12px; }
@media (max-width: 900px) {
  .top, .row2, .charts { grid-template-columns: minmax(0, 1fr); }
}
</style>
</head>
<body>
<main>
<header>
  <h1>Training Dashboard</h1>
  <div>
    <span class="muted">Data until {{ d.today.strftime("%a %d.%m.%Y") }}</span>
    <button class="theme" id="theme" type="button" aria-label="Switch color theme">Theme: auto</button>
  </div>
</header>

<section class="top">
  <div class="card hero">
    <div class="sub">{{ d.hero.label }}</div>
    <div class="value">{{ d.hero.value }}</div>
    <div class="muted">{{ d.hero.detail }}</div>
  </div>
  <div class="tiles">
  {% for t in d.tiles %}
    <div class="card tile">
      <div class="label">{{ t.label }}</div>
      <div class="value">
        {% if t.status %}<span class="status {{ t.status }}" aria-hidden="true">{{ {"green": "✓", "yellow": "!", "red": "✕"}[t.status] }}</span>{% endif %}
        {{ t.value }}
      </div>
      <div class="detail">{{ t.detail }}</div>
    </div>
  {% endfor %}
  </div>
</section>

<section class="row2">
  <div class="card">
    <h2>Morning check</h2>
    <ul class="signals">
    {% for s in d.morning.signals %}
      <li>
        <span class="name">{{ {"tendon": "Patellar tendon", "hrv": "HRV", "resting_hr": "Resting HR", "legs": "Legs"}.get(s.signal, s.signal) }}</span>
        {% if s.level %}<span class="status {{ s.level }}" aria-hidden="true">{{ {"green": "✓", "yellow": "!", "red": "✕"}[s.level] }}</span><span>{{ s.level|capitalize }}</span>{% else %}<span class="muted">–</span>{% endif %}
        <span class="muted">{{ s.reason }}</span>
      </li>
    {% endfor %}
    </ul>
    <h2 style="margin-top:16px">Warnings</h2>
    {% if d.warnings %}
    <ul class="warnings">{% for w in d.warnings %}<li>{{ w }}</li>{% endfor %}</ul>
    {% else %}<p class="muted">None.</p>{% endif %}
  </div>
  <div class="card">
    <h2>Plan</h2>
    <p class="sub">Last {{ 14 }} days and the coming week</p>
    {% if d.plan_rows %}
    <div class="scroll"><table>
      <thead><tr><th>Date</th><th>Type</th><th>Session</th><th>Planned</th><th>Done</th><th>Status</th></tr></thead>
      <tbody>
      {% for r in d.plan_rows %}
        <tr{% if r.today %} class="today"{% endif %}>
          <td>{{ r.weekday }} {{ r.date }}</td><td>{{ r.type }}</td>
          <td>{{ r.session }}{% for f in r.findings %}<div class="finding">{{ f }}</div>{% endfor %}</td>
          <td>{{ r.planned }}</td><td>{{ r.actual }}</td><td>{{ r.status }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table></div>
    {% for w in d.plan_weeks %}
      <p class="sub" style="margin-top:8px">Week of {{ w.week_start }}{% if w.label %} ({{ w.label }}){% endif %}: {{ "%g"|format(w.actual_km) }} km of {{ "%g"|format(w.planned_km[0]) }}{% if w.planned_km[1] != w.planned_km[0] %}–{{ "%g"|format(w.planned_km[1]) }}{% endif %} km, {{ w.status }}</p>
    {% endfor %}
    {% else %}<p class="muted">No plan.yaml, or no sessions around today.</p>{% endif %}
  </div>
</section>

<section class="charts">
{% for c in charts %}
  <div class="card">
    <h2>{{ c.title }}</h2>
    <p class="sub">{{ c.subtitle }}</p>
    {% if c.empty %}<div class="empty">{{ c.empty }}</div>{% else %}<div class="plot" id="chart-{{ c.id }}" role="img" aria-label="{{ c.title }}: {{ c.subtitle }}"></div>{% endif %}
    <details>
      <summary>Table</summary>
      <div class="scroll"><table>
        <thead><tr>{% for col in c.table.columns %}<th>{{ col }}</th>{% endfor %}</tr></thead>
        <tbody>{% for row in c.table.rows %}<tr>{% for v in row %}<td>{{ "–" if v is none else v }}</td>{% endfor %}</tr>{% endfor %}</tbody>
      </table></div>
    </details>
  </div>
{% endfor %}
</section>

<section class="card" style="margin-top:16px">
  <h2>Runs, last 14 days</h2>
  <div class="scroll"><table>
    <thead><tr><th>Date</th><th>Name</th><th>km</th><th>Pace</th><th>Avg HR</th><th>Above easy cap</th><th>Aerobic TE</th><th>RPE</th><th>VO2max</th></tr></thead>
    <tbody>
    {% for r in d.runs %}
      <tr>
        <td>{{ r.date }}</td><td>{{ r.name or r.type }}</td><td>{{ r.distance_km }}</td><td>{{ r.pace_min_per_km or "–" }}</td>
        <td>{{ r.avg_hr_bpm or "–" }}</td>
        <td>{% for k, v in r.items() if k.startswith("time_above_") %}{{ "–" if v is none else v ~ " %" }}{% endfor %}</td>
        <td>{{ r.aerobic_training_effect or "–" }}</td><td>{{ r.garmin_rpe_1_to_10 or "–" }}</td><td>{{ r.vo2max or "–" }}</td>
      </tr>
    {% else %}
      <tr><td colspan="9" class="muted">No runs in the last 14 days.</td></tr>
    {% endfor %}
    </tbody>
  </table></div>
</section>

<footer>Generated by runlog from Garmin data. Charts need an internet connection to load Plotly.</footer>
</main>

<script src="{{ plotly_js }}"></script>
<script>
const CHARTS = {{ charts | tojson }};
const root = document.documentElement;

function token(name) { return getComputedStyle(root).getPropertyValue(name).trim(); }

// Replace "var(--x)" strings with the current theme's value, recursively.
function resolve(value) {
  if (typeof value === "string") {
    const m = value.match(/^var\((--[\w-]+)\)$/);
    return m ? token(m[1]) : value;
  }
  if (Array.isArray(value)) return value.map(resolve);
  if (value && typeof value === "object") {
    const out = {};
    for (const [k, v] of Object.entries(value)) out[k] = resolve(v);
    return out;
  }
  return value;
}

function merge(base, extra) {
  const out = { ...base };
  for (const [k, v] of Object.entries(extra || {})) {
    out[k] = v && typeof v === "object" && !Array.isArray(v) && base[k] ? merge(base[k], v) : v;
  }
  return out;
}

function baseLayout() {
  const axis = {
    gridcolor: "var(--grid)", linecolor: "var(--axis)", zeroline: false, showline: false,
    tickfont: { color: "var(--muted)", size: 11 }, automargin: true, fixedrange: true,
  };
  return {
    font: { family: 'system-ui, -apple-system, "Segoe UI", sans-serif', color: "var(--text-secondary)", size: 12 },
    paper_bgcolor: "rgba(0,0,0,0)", plot_bgcolor: "rgba(0,0,0,0)",
    margin: { l: 8, r: 8, t: 8, b: 8 },
    xaxis: { ...axis, showgrid: false, showline: true },
    yaxis: { ...axis, showgrid: true, rangemode: "tozero" },
    legend: { orientation: "h", x: 0, y: 1.02, yanchor: "bottom", font: { color: "var(--text-secondary)" } },
    hovermode: "closest",
    hoverlabel: { bgcolor: "var(--surface-1)", bordercolor: "var(--axis)", font: { color: "var(--text-primary)" } },
    bargap: 0.45, bargroupgap: 0.08, barcornerradius: 4,
  };
}

function render() {
  if (!window.Plotly) return;
  for (const c of CHARTS) {
    const el = document.getElementById("chart-" + c.id);
    if (!el) continue;
    Plotly.react(el, resolve(c.data), resolve(merge(baseLayout(), c.layout)),
      { displayModeBar: false, responsive: true });
  }
}

// Theme toggle: auto (follows the OS) -> light -> dark.
const button = document.getElementById("theme");
function label() { button.textContent = "Theme: " + (root.dataset.theme || "auto"); }
button.addEventListener("click", () => {
  const next = { undefined: "light", light: "dark", dark: undefined }[root.dataset.theme];
  if (next) root.dataset.theme = next; else delete root.dataset.theme;
  try { next ? localStorage.setItem("runlog-theme", next) : localStorage.removeItem("runlog-theme"); } catch (e) {}
  label(); render();
});
matchMedia("(prefers-color-scheme: dark)").addEventListener("change", render);
label();
render();
</script>
</body>
</html>
